@{
    ViewBag.Title = "Pagos";
}

<h2>Pagos Realizados</h2>

<table class="table" id="tablaPagos">
    <thead>
        <tr>
            <th>ID</th>
            <th>Empleado</th>
            <th>Monto</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<script>
    async function cargarPagos() {
        const r = await fetch('/api/pagos');
        const arr = await r.json();

        const tb = document.querySelector('#tablaPagos tbody');
        tb.innerHTML = '';

        arr.forEach(p => {
            tb.innerHTML += `
            <tr>
                <td>${p.Id}</td>
                <td>${p.Empleado}</td>
                <td>$${p.Monto.toFixed(2)}</td>
                <td>${new Date(p.Fecha).toLocaleString()}</td>
            </tr>`;
        });
    }

    window.onload = cargarPagos;
</script>
