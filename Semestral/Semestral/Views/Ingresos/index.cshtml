@{
    ViewBag.Title = "Ingresos";
}
<h2>Ingresos</h2>

<div class="mb-3">
    <input id="monto" type="number" step="0.01" class="form-control" placeholder="Monto" />
    <input id="origen" class="form-control mt-1" placeholder="Origen (opcional)" />
    <button id="btnIngreso" class="btn btn-primary mt-2">Registrar Ingreso</button>
</div>

<h4>Lista de Ingresos</h4>
<ul id="listaIngresos" class="list-group"></ul>

<script>
    const baseUrl = '';

    async function cargarIngresos() {
        const r = await fetch(baseUrl + '/api/ingresos');
        const arr = await r.json();
        const ul = document.getElementById('listaIngresos');
        ul.innerHTML = '';
        arr.forEach(i => {
            const li = document.createElement('li');
            li.className = 'list-group-item';
            li.innerText = `${i.Id} - ${new Date(i.Fecha).toLocaleString()} - ${i.Monto} - ${i.Origen || ''}`;
            ul.appendChild(li);
        });
    }

    document.getElementById('btnIngreso').addEventListener('click', async () => {
        const monto = parseFloat(document.getElementById('monto').value || 0);
        const origen = document.getElementById('origen').value || 'Manual';
        if (monto <= 0) { alert('Monto inválido'); return; }
        await fetch(baseUrl + '/api/ingresos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ Fecha: new Date(), Monto: monto, Origen: origen })
        });
        document.getElementById('monto').value = '';
        document.getElementById('origen').value = '';
        await cargarIngresos();
        // actualizar panel
        await fetch('/api/empresa');
    });

    window.onload = cargarIngresos;
</script>
